# Direct local HTTP development
AUTH_ADDR=:8090
AUTH_DATA_FILE=data/store.json
AUTH_SECURE_COOKIES=false

# PostgreSQL runtime foundation (optional). When AUTH_DATABASE_URL is set, the
# service validates the connection string, connects, and applies versioned
# schema migrations before it accepts traffic. Failures are reported without
# exposing the password. When unset the JSON-file store (AUTH_DATA_FILE) is
# used; the store cutover to Postgres is a later ticket.
# AUTH_DATABASE_URL=postgres://authserver:PASSWORD@localhost:5432/authserver

# Set for the PostgreSQL integration env used by `go test` (repeatable schema
# initialization). Unset in normal development.
# TEST_DATABASE_URL=postgres://authserver:PASSWORD@localhost:5432/authserver

# Google OAuth (optional). Add this callback URL to your Google OAuth client:
# HTTP development callback:
# http://localhost:8090/api/auth/google/callback
# Local HTTPS callback through Caddy:
# https://localhost:8443/api/auth/google/callback
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_REDIRECT_URL=http://localhost:8090/api/auth/google/callback

# Facebook OAuth (optional):
# AUTH_FACEBOOK_CLIENT_ID=
# AUTH_FACEBOOK_CLIENT_SECRET=
# AUTH_FACEBOOK_REDIRECT_URL=http://localhost:8090/api/auth/facebook/callback

# GitHub OAuth (optional):
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GITHUB_REDIRECT_URL=http://localhost:8090/api/auth/github/callback

# Microsoft OAuth (optional; register as a multitenant app):
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_REDIRECT_URL=http://localhost:8090/api/auth/microsoft/callback

# Apple OAuth (optional; client secret must be an Apple-generated JWT):
# AUTH_APPLE_CLIENT_ID=
# AUTH_APPLE_CLIENT_SECRET=
# AUTH_APPLE_REDIRECT_URL=http://localhost:8090/api/auth/apple/callback

# GitLab OAuth (optional; GitLab.com):
# AUTH_GITLAB_CLIENT_ID=
# AUTH_GITLAB_CLIENT_SECRET=
# AUTH_GITLAB_REDIRECT_URL=http://localhost:8090/api/auth/gitlab/callback

# Discord OAuth (optional):
# AUTH_DISCORD_CLIENT_ID=
# AUTH_DISCORD_CLIENT_SECRET=
# AUTH_DISCORD_REDIRECT_URL=http://localhost:8090/api/auth/discord/callback

# LinkedIn OAuth/OpenID Connect (optional):
# AUTH_LINKEDIN_CLIENT_ID=
# AUTH_LINKEDIN_CLIENT_SECRET=
# AUTH_LINKEDIN_REDIRECT_URL=http://localhost:8090/api/auth/linkedin/callback

# Twitter/X OAuth (optional):
# AUTH_TWITTER_CLIENT_ID=
# AUTH_TWITTER_CLIENT_SECRET=
# AUTH_TWITTER_REDIRECT_URL=http://localhost:8090/api/auth/twitter/callback

# Generic OpenID Connect (optional; issuer must expose discovery metadata):
# AUTH_OIDC_ISSUER=https://id.example.com/realms/example
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URL=http://localhost:8090/api/auth/oidc/callback

# Production behind HTTPS: copy these values into your service environment.
# AUTH_ADDR=:8090
# AUTH_DATA_FILE=/var/lib/authserver/store.json
# AUTH_SECURE_COOKIES=true
